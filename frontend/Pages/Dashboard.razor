@page "/dashboard"
@attribute [Authorize]
@inject NotiesBlazor.Controllers.UserController UserController
@inject NavigationManager Navigation

<div style="display: flex; align-items: center; justify-content: center; height: 100vh; background-color: #f8fafc; flex-direction: column; gap: 1rem;">
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    <span style="font-size: 11px; font-weight: bold; letter-spacing: 0.1em; color: #94a3b8; font-family: 'Inter', sans-serif;">
        CONFIGURANDO ESPACIO DE TRABAJO...
    </span>
</div>

@code {
    protected override void OnInitialized()
    {
        var currentUser = UserController.SessionUser!;

        switch (currentUser.Role)
        {
            case NotiesBlazor.Models.UserRole.Administrador:
                Navigation.NavigateTo("/usuarios");
                break;

            case NotiesBlazor.Models.UserRole.Docente:
                Navigation.NavigateTo("/materias"); 
                break;

            case NotiesBlazor.Models.UserRole.Representante:
                Navigation.NavigateTo("/materias");
                break;

            default:
                Navigation.NavigateTo("/login");
                break;
        }
    }
}