@using NotiesBlazor.Controllers
@using NotiesBlazor.Models
@using static NotiesBlazor.Controllers.MateriasController
@inject MateriasController MateriasCtrl
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<div class="d-flex align-center justify-space-between mb-6">
    <div>
        <MudText Typo="Typo.h4" Color="Color.Primary" Style="font-weight: 700;">Control de Materias Globales</MudText>
        <MudText Typo="Typo.subtitle1" Class="text-muted">Panel administrativo para dar de alta asignaturas y delegar profesores.</MudText>
    </div>
    <MudButton Variant="Variant.Filled" 
               Color="Color.Primary" 
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="AbrirFormularioMateria"
               Class="rounded-lg">
        Nueva Materia
    </MudButton>
</div>

@if (materias == null || !materias.Any())
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="rounded-lg">
        No hay materias registradas en el sistema.
    </MudAlert>
}
else
{
    <MudGrid>
        @foreach (var materia in materias)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="3" Class="rounded-xl hover-card py-2" Style="border-top: 5px solid var(--mud-palette-primary); height: 100%;">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6" Style="font-weight: 600;">@(materia.Nombre ?? "Materia sin nombre")</MudText>
                            <div class="d-flex align-center mt-1 text-muted">
                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-1"/>
                                <MudText Typo="Typo.body2">Prof: @(materia.Profesor ?? "No asignado")</MudText>
                            </div>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
                                @(string.IsNullOrEmpty(materia.Nombre) ? "MT" : materia.Nombre.Substring(0, Math.Min(2, materia.Nombre.Length)).ToUpper())
                            </MudAvatar>
                        </CardHeaderActions>
                    </MudCardHeader>
                        <MudCardActions Class="justify-end px-4">
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Primary" 
                                       StartIcon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       Class="rounded-pill"
                                       OnClick="@(() => EditarMateria(materia))">
                                        Editar
                            </MudButton>

                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Error" 
                                       StartIcon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       Class="rounded-pill"
                                       OnClick="@(() => EliminarMateria(materia))">
                                        Eliminar
                            </MudButton>

                            <MudButton Variant="Variant.Filled" 
                                       Color="Color.Primary" 
                                       EndIcon="@Icons.Material.Filled.ArrowForward" 
                                       Size="Size.Small" 
                                       Class="rounded-pill" 
                                       OnClick="@(() => IrAActividades(materia.Id))">
                                        Ver Actividades
                            </MudButton>
                        </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    [Parameter] public User CurrentUser { get; set; } = default!;
    private List<Materia> materias = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarMaterias();
    }

    private async Task CargarMaterias()
    {
        try
        {
            var todas = await MateriasCtrl.GetMateriasAsync();
            materias = todas ?? new List<Materia>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar materias: {ex.Message}", Severity.Error);
        }
    }

    private async Task AbrirFormularioMateria()
    {
        var opciones = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<FormularioMateria>("", opciones);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await CargarMaterias(); 
            StateHasChanged();
        }
    }

    private async Task EditarMateria(Materia materia)
{
    var opciones = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };

    var parametros = new DialogParameters
    {
        { "MateriaEditar", materia }
    };

    var dialog = await DialogService.ShowAsync<FormularioMateria>("", parametros, opciones);
    var result = await dialog.Result;

    if (result != null && !result.Canceled)
    {
        await CargarMaterias();
        StateHasChanged();
    }
}

private async Task EliminarMateria(Materia materia)
{
    bool? confirmar = await DialogService.ShowMessageBox(
        "Eliminar materia",
        $"¿Está seguro de eliminar la materia '{materia.Nombre}'?",
        yesText: "Eliminar",
        cancelText: "Cancelar"
    );

    if (confirmar == true)
    {
        try
        {
            await MateriasCtrl.DeleteMateriaAsync(materia.Id);

            Snackbar.Add("Materia eliminada correctamente.", Severity.Success);

            await CargarMaterias();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}

    private void IrAActividades(int id) => Navigation.NavigateTo($"/materias/{id}/actividades");
}